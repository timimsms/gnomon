        "events_timed_shape": {
          "name": "events_timed_shape",
          "value": "\"events\".\"timing_kind\" <> 'timed' OR (\n            \"events\".\"start_local\" IS NOT NULL AND \"events\".\"end_local\" IS NOT NULL\n            AND \"events\".\"time_zone\" IS NOT NULL\n            AND \"events\".\"start_date\" IS NULL AND \"events\".\"end_date\" IS NULL)"
        },
        "events_all_day_shape": {
          "name": "events_all_day_shape",
          "value": "\"events\".\"timing_kind\" <> 'allDay' OR (\n            \"events\".\"start_date\" IS NOT NULL AND \"events\".\"end_date\" IS NOT NULL\n            AND \"events\".\"start_local\" IS NULL AND \"events\".\"end_local\" IS NULL\n            AND \"events\".\"time_zone\" IS NULL)"
        },
        "events_timed_order": {
          "name": "events_timed_order",
          "value": "\"events\".\"end_local\" IS NULL OR \"events\".\"end_local\" >= \"events\".\"start_local\""
        },
        "events_all_day_order": {
          "name": "events_all_day_order",
          "value": "\"events\".\"end_date\" IS NULL OR \"events\".\"end_date\" > \"events\".\"start_date\""
        }
      },
